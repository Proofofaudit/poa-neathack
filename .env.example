# The reproducible demo needs no API keys.
POA_LLM_ENABLED=false
POA_TELEMETRY_ENABLED=false

# Optional Base fork / read-only sentinel. Never use a mainnet signing key for the demo.
BASE_RPC_URL=https://mainnet.base.org
# BASE_FORK_BLOCK=

# Optional live review: first rotate any credentials previously pasted into logs.
# OPENAI_API_KEY=
# LITELLM_API_KEY=
# LITELLM_BASE_URL=
# LITELLM_MODEL=

# Optional telemetry export. Local traces work without credentials.
# NEATLOGS_API_KEY=
# NEATLOGS_PROJECT_ID=

# Production displays saved evidence by default.
ALLOW_PROD_SIMULATION=false
# POA_DEMO_TOKEN= (at least 32 random characters; do not commit it)

# Authenticated live model planning on the deployed agent (public rule mode needs no model key).
POA_LIVE_AGENT_ENABLED=false

# Enable public, server-key AI for the fixed historical example only.
# Five public model starts per 10 minutes and one concurrent run per instance.
# This is not an account-wide provider spending limit.
POA_PUBLIC_AI_ENABLED=false
