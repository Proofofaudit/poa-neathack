{
  "name": "poa-neathack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:build": "export PATH=$HOME/.foundry/bin:$PATH && forge build",
    "contracts:test": "export PATH=$HOME/.foundry/bin:$PATH && forge test -v",
    "demo:seed": "tsx scripts/seed_scenario.ts",
    "demo:investigate": "tsx scripts/run_investigation.ts",
    "demo:payout": "tsx scripts/execute_payout.ts",
    "demo:all": "bash scripts/demo_all.sh"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.7",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "neatlogs": "latest",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
