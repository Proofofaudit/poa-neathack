{
  "name": "poa-neathack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "contracts:build": "export PATH=$HOME/.foundry/bin:$PATH && (cd contracts && forge build)",
    "contracts:test": "export PATH=$HOME/.foundry/bin:$PATH && (cd contracts && forge test -v)",
    "test:benchmark": "tsx scripts/benchmark_evmbench.ts",
    "verify:release": "npm run typecheck && npm run contracts:test && npm test && npm run build",
    "mcp": "tsx src/mcp/server.ts",
    "sentinel:watch": "DEMO_MODE=true tsx scripts/watch_production_sentinel.ts",
    "demo:all": "bash scripts/demo_all.sh",
    "demo:base-fork": "tsx scripts/run_base_fork.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "neatlogs": "latest",
    "next": "^14.2.24",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
